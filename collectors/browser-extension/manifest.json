{
  "manifest_version": 3,
  "name": "Usagecheck GPT Collector",
  "version": "0.2.0",
  "description": "Counts ChatGPT web usage locally and shares the total with the Usagecheck GPT GitHub Pages dashboard.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://mnpworld.github.io/Usagecheck_GPT/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://mnpworld.github.io/Usagecheck_GPT/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Usagecheck GPT Collector"
  }
}
